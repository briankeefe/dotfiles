#!/usr/bin/env bash
set -euo pipefail

dir="$HOME/Pictures/Screenshots"
mkdir -p "$dir"
file="$dir/$(date +'%Y-%m-%d_%H-%M-%S').png"

if [[ ${1:-} == --display ]]; then
  grim "$file"
else
  geometry=$(slurp) || exit 0
  grim -g "$geometry" "$file"
fi

wl-copy < "$file"
notify-send 'Screenshot saved' "$file"
